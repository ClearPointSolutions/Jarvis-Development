# Safe local-development examples only. Copy to .env and add local-only values.
JARVIS_ENV=development
JARVIS_API_HOST=127.0.0.1
JARVIS_API_PORT=8000
JARVIS_PUBLIC_ORIGIN=http://127.0.0.1:3000
JARVIS_CSRF_HMAC_KEY_FILE=
JARVIS_SESSION_COOKIE_NAME=jarvis_session
JARVIS_SESSION_IDLE_SECONDS=1800
JARVIS_SESSION_ABSOLUTE_SECONDS=43200
JARVIS_SESSION_TOUCH_INTERVAL_SECONDS=60
JARVIS_COOKIE_SECURE=false
JARVIS_LOGIN_WINDOW_SECONDS=900
JARVIS_LOGIN_ACCOUNT_LIMIT=5
JARVIS_LOGIN_NETWORK_LIMIT=20
JARVIS_LOGIN_BASE_DELAY_SECONDS=1
JARVIS_LOGIN_MAX_DELAY_SECONDS=300
JARVIS_API_INSTANCE_ID=api-local
JARVIS_EVENT_INLINE_BYTES=32768
JARVIS_EVENT_MAX_BYTES=65536
JARVIS_EVENT_REPLAY_PAGE_SIZE=250
JARVIS_SSE_KEEPALIVE_SECONDS=15
JARVIS_SSE_POLL_SECONDS=2
JARVIS_SSE_MAX_CONNECTIONS=20
JARVIS_ORCHESTRATOR_MAX_CONCURRENCY=1
JARVIS_ORCHESTRATOR_GLOBAL_CONCURRENCY=1
JARVIS_ORCHESTRATOR_RUNTIME_MODE=real
# Required private JSON manifest; no credentials or deployment paths in registry data.
JARVIS_ORCHESTRATOR_RUNTIME_FILE=./config/runtime.json
JARVIS_ORCHESTRATOR_LEASE_SECONDS=30
JARVIS_ORCHESTRATOR_POLL_SECONDS=0.2
JARVIS_ORCHESTRATOR_GRACE_SECONDS=10
DATABASE_URL=postgresql+psycopg://jarvis_v1_dev@127.0.0.1:55432/jarvis_v1_test
TEST_DATABASE_URL=postgresql+psycopg://jarvis_v1_dev@127.0.0.1:55432/jarvis_v1_test
JARVIS_ARTIFACT_ROOT=./var/artifacts
# Provider URLs/model tags belong in immutable registry revisions. Exact endpoint
# allowlisting and credential-file references belong in the runtime JSON manifest.
# Next.js host/port are CLI arguments, e.g. npm run dev -- --hostname 127.0.0.1 --port 3000.
