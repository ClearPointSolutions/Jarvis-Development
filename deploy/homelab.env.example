# Jarvis V1 homelab deployment env -- trusted private-LAN HTTP.
#
# Copy to <root>/shared/homelab.env (default <root> is /opt/jarvis-v1), fill in
# the values below, then:
#
#   docker compose --project-name jarvis-v1 \
#     --env-file /opt/jarvis-v1/shared/homelab.env \
#     -f deploy/compose.production.yml -f deploy/compose.homelab.yml up -d
#
# scripts/install-homelab.sh writes this file for you. It contains NO secrets --
# database passwords and the CSRF key are files under JARVIS_SECRET_DIR, created
# by scripts/provision_secrets.py.

# Exact browser origin, including the port. The API compares the forwarded Host
# and Origin to this verbatim, so it must match how operators actually reach the
# machine (for the reference homelab: http://192.168.40.105:13000).
JARVIS_PUBLIC_ORIGIN=http://REPLACE_WITH_LAN_IP:13000

# Published Mission Control port and the host interface it binds to. 0.0.0.0
# exposes it to the whole LAN; narrow it to a VPN address if you have one.
JARVIS_WEB_PORT=13000
JARVIS_WEB_BIND=0.0.0.0

# Loopback-only maintenance bind for the API container port.
JARVIS_API_PORT=18000

# Immutable image references. scripts/install-homelab.sh builds
# jarvis-v1-python:local-<sha> / jarvis-v1-web:local-<sha> and rewrites these if
# they are left blank.
JARVIS_PYTHON_IMAGE=
JARVIS_WEB_IMAGE=

# Operator-provisioned directories (never in Git). Secrets are mounted read-only
# into the consuming service only.
JARVIS_SECRET_DIR=/opt/jarvis-v1/secrets
JARVIS_PRIVATE_CONFIG_DIR=/opt/jarvis-v1/config

# JSON array of exact provider base URLs the API may reach. Empty allowlist by
# default; the orchestrator's private runtime manifest has its own allowlist.
JARVIS_PROVIDER_ALLOWED_ENDPOINTS=[]

# Username created by scripts/owner-bootstrap.sh (password is prompted, never
# stored here).
JARVIS_OWNER_USERNAME=owner
