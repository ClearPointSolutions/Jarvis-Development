# Jarvis V1 production deployment env -- HTTPS via a reviewed reverse proxy.
#
# Copy to <root>/shared/production.env, fill in the values, then:
#
#   docker compose --project-name jarvis-v1 \
#     --env-file /opt/jarvis-v1/shared/production.env \
#     -f deploy/compose.production.yml up -d
#
# The production Compose file keeps JARVIS_ENV=production, Secure cookies, an
# HTTPS public origin and loopback-only application ports. It does NOT terminate
# TLS. Front the loopback web (13000) and API (18000) ports with the reviewed
# proxy in deploy/reverse-proxy.nginx.conf.example. Contains NO secrets.

# Public HTTPS origin the browser uses. MUST be https:// in production.
JARVIS_PUBLIC_ORIGIN=https://jarvis.example.invalid

# Loopback publish ports the TLS proxy forwards to. Leave as-is unless the proxy
# config is changed to match.
JARVIS_WEB_PORT=13000
JARVIS_API_PORT=18000

# Immutable, digest-pinned image references built by CI. Required.
JARVIS_PYTHON_IMAGE=
JARVIS_WEB_IMAGE=

# Operator-provisioned directories (never in Git).
JARVIS_SECRET_DIR=/opt/jarvis-v1/secrets
JARVIS_PRIVATE_CONFIG_DIR=/opt/jarvis-v1/config

# JSON array of exact provider base URLs the API may reach.
JARVIS_PROVIDER_ALLOWED_ENDPOINTS=[]

# Username created by scripts/owner-bootstrap.sh.
JARVIS_OWNER_USERNAME=owner
